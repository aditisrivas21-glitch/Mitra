# Copy this file to ".env" and fill in your key. NEVER commit ".env" to Git.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. If you see "model not found", check the current free models in Google AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated list of frontend URLs allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
MAX_UPLOAD_MB=5
